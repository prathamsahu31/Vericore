# Copy to .env and fill in. .env is gitignored — never commit it.

# ── LLM ──────────────────────────────────────────────────────
# 'stub' | 'gemini' | 'anthropic'
# 'stub' runs with no key and no network. Switch to a real
# provider only when a task genuinely needs a live call.
LLM_PROVIDER=stub

# Optional per-role override. Leave blank to use LLM_PROVIDER
# for both. Recommended for the final demo: extraction on the
# free tier, reasoning on a paid provider.
LLM_PROVIDER_EXTRACTION=
LLM_PROVIDER_REASONING=

# Free, no card required: aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed if you switch the reasoning role to Anthropic
ANTHROPIC_API_KEY=

LLM_CACHE_DIR=.llm_cache
LLM_MAX_REQUESTS_PER_MINUTE=10
LLM_MAX_RETRIES=3

# Model IDs are NOT set here. They live in
# backend/app/llm/config.py as a (provider, role) -> model map.

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://vericore:vericore@localhost:5432/vericore

# ── Storage ──────────────────────────────────────────────────
STORAGE_PATH=./storage

# ── Verification adapters ────────────────────────────────────
# 'simulated' | 'hybrid'
PORTAL_MODE=simulated

# ── Demo determinism ─────────────────────────────────────────
# Pin the bid due date so certificate-expiry checks give the
# same result every run. Format: YYYY-MM-DD
BID_DUE_DATE_OVERRIDE=

# ── App ──────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
