# ═══════════════════════════════════════════════════════════════════
#  THE API KEY LIVES HERE, AND ONLY HERE.
#
#  To swap in a different key, change the one line below. Nothing else
#  in the repository holds a key, and nothing needs editing alongside
#  it. `.env` is gitignored, so a key here is never committed.
# ═══════════════════════════════════════════════════════════════════

LLM_PROVIDER=openai
OPENAI_API_KEY=

# Other providers stay implemented and switchable. Set LLM_PROVIDER to
# one of: openai | gemini | stub   ('stub' runs offline with no key).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional per-role override. Leave blank to use LLM_PROVIDER for both.
LLM_PROVIDER_EXTRACTION=
LLM_PROVIDER_REASONING=

# Copy to .env and fill in. .env is gitignored — never commit it.

LLM_CACHE_DIR=.llm_cache
LLM_MAX_REQUESTS_PER_MINUTE=10
LLM_MAX_RETRIES=3

# Model IDs are NOT set here. They live in
# backend/app/llm/config.py as a (provider, role) -> model map.

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://vericore:vericore@localhost:5432/vericore

# ── Storage ──────────────────────────────────────────────────
STORAGE_PATH=./storage

# ── Verification adapters ────────────────────────────────────
# 'simulated' | 'hybrid'
PORTAL_MODE=simulated

# ── Demo determinism ─────────────────────────────────────────
# Pin the bid due date so certificate-expiry checks give the
# same result every run. Format: YYYY-MM-DD
BID_DUE_DATE_OVERRIDE=

# ── App ──────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
